[Unit]
Description=qsim single scheduled pipeline; enable only after local acceptance

[Timer]
OnBootSec=8min
OnCalendar=*-*-* 18:00:00 Asia/Shanghai
OnCalendar=*-*-* 18:30:00 Asia/Shanghai
OnCalendar=*-*-* 19:30:00 Asia/Shanghai
OnCalendar=*-*-* 20:00:00 Asia/Shanghai
OnCalendar=*-*-* 21:45:00 Asia/Shanghai
Persistent=true
AccuracySec=1min
Unit=qsim-data-reconcile.service

[Install]
WantedBy=timers.target
