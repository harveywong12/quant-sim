TZ=Asia/Shanghai
QSIM_SCHEDULER_ENABLED=0
QSIM_SCHEDULE_OWNER=systemd
QSIM_NATIVE_MARKET=0
QSIM_PAPER_AUTORUN=0
QSIM_FORMAL_PAPER=0
QSIM_REFACTOR_ROOT=/srv/qsim
QSIM_LEGACY_ROOT=/srv/qsim-legacy
QSIM_SYNC_BACKUP_ROOT=/srv/qsim-backups/data-sync
QSIM_SYNC_BACKUP_RETENTION=7
QSIM_CALENDAR_FILE=/srv/qsim/config/trading-calendar.json
QSIM_AUTH_TOKEN_FILE=/srv/qsim/.secrets/web-token
QSIM_MARKET_TOKEN_FILE=/srv/qsim/.secrets/tushare-token
QSIM_LEGACY_AUTH_TOKEN_FILE=/srv/qsim/.secrets/legacy-token
# Fill only after local authenticated HTTPS validation.
QSIM_TUSHARE_HTTPS_URL=
QSIM_NTFY_URL=
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
