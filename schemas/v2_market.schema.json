{
  "database_name": "v2_market.db",
  "table_count": 13,
  "objects": [
    {
      "type": "table",
      "name": "adj_factor",
      "tbl_name": "adj_factor",
      "sql": "CREATE TABLE adj_factor (\n    ts_code    TEXT NOT NULL,\n    trade_date TEXT NOT NULL,\n    adj_factor REAL NOT NULL,\n    PRIMARY KEY (ts_code, trade_date)\n)"
    },
    {
      "type": "table",
      "name": "cb_basic_snapshot",
      "tbl_name": "cb_basic_snapshot",
      "sql": "CREATE TABLE cb_basic_snapshot (\n  ts_code TEXT PRIMARY KEY, stk_code TEXT, bond_short_name TEXT,\n  list_date TEXT, delist_date TEXT, maturity_date TEXT,\n  conv_price REAL, remain_size REAL, issue_size REAL)"
    },
    {
      "type": "table",
      "name": "cb_daily_raw",
      "tbl_name": "cb_daily_raw",
      "sql": "CREATE TABLE cb_daily_raw (\n  ts_code TEXT, trade_date TEXT, open REAL, high REAL, low REAL,\n  close REAL, vol REAL, amount REAL,\n  PRIMARY KEY(ts_code, trade_date))"
    },
    {
      "type": "table",
      "name": "cb_indicator",
      "tbl_name": "cb_indicator",
      "sql": "CREATE TABLE cb_indicator (\n  ts_code TEXT, trade_date TEXT, close REAL, stk_close REAL,\n  conv_value REAL, premium_rate REAL, dual_low REAL,\n  PRIMARY KEY(ts_code, trade_date))"
    },
    {
      "type": "table",
      "name": "corporate_actions",
      "tbl_name": "corporate_actions",
      "sql": "CREATE TABLE corporate_actions (\n    id             INTEGER PRIMARY KEY AUTOINCREMENT,\n    venue          TEXT NOT NULL,\n    symbol         TEXT NOT NULL,\n    ex_date        TEXT NOT NULL,\n    kind           TEXT NOT NULL,\n    ratio          TEXT,\n    cash_per_share TEXT,\n    currency       TEXT NOT NULL DEFAULT 'CNY',\n    note           TEXT NOT NULL DEFAULT '',\n    UNIQUE(venue, symbol, ex_date, kind)\n)"
    },
    {
      "type": "table",
      "name": "events",
      "tbl_name": "events",
      "sql": "CREATE TABLE events (\n    seq            INTEGER PRIMARY KEY AUTOINCREMENT,\n    schema_version INTEGER NOT NULL,\n    type           TEXT NOT NULL,\n    account        TEXT NOT NULL,\n    ts_event       TEXT NOT NULL,\n    ts_recv        TEXT NOT NULL,\n    payload        TEXT NOT NULL\n)"
    },
    {
      "type": "table",
      "name": "experiments",
      "tbl_name": "experiments",
      "sql": "CREATE TABLE experiments (\n    id           INTEGER PRIMARY KEY AUTOINCREMENT,\n    created_at   TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    name         TEXT NOT NULL,\n    git_sha      TEXT NOT NULL,\n    data_start   TEXT NOT NULL,\n    data_end     TEXT NOT NULL,\n    params_hash  TEXT NOT NULL,\n    params_json  TEXT NOT NULL,\n    metrics_json TEXT NOT NULL,\n    note         TEXT NOT NULL DEFAULT ''\n)"
    },
    {
      "type": "table",
      "name": "frozen_config",
      "tbl_name": "frozen_config",
      "sql": "CREATE TABLE frozen_config (\n    key        TEXT PRIMARY KEY,\n    fingerprint TEXT NOT NULL,\n    params_json TEXT NOT NULL,\n    frozen_at  TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP\n)"
    },
    {
      "type": "table",
      "name": "ledger_meta",
      "tbl_name": "ledger_meta",
      "sql": "CREATE TABLE ledger_meta (\n    key TEXT PRIMARY KEY,\n    value TEXT NOT NULL\n)"
    },
    {
      "type": "table",
      "name": "premium_daily",
      "tbl_name": "premium_daily",
      "sql": "CREATE TABLE premium_daily (\n    date         TEXT NOT NULL,\n    venue        TEXT NOT NULL,\n    token_symbol TEXT NOT NULL,\n    underlying   TEXT NOT NULL,\n    token_close  REAL NOT NULL,\n    und_close    REAL NOT NULL,\n    premium_pct  REAL NOT NULL,\n    PRIMARY KEY (date, venue, token_symbol)\n)"
    },
    {
      "type": "table",
      "name": "schema_migrations",
      "tbl_name": "schema_migrations",
      "sql": "CREATE TABLE schema_migrations( version INTEGER PRIMARY KEY, applied_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)"
    },
    {
      "type": "table",
      "name": "stk_close_daily",
      "tbl_name": "stk_close_daily",
      "sql": "CREATE TABLE stk_close_daily (\n  ts_code TEXT, trade_date TEXT, close REAL,\n  PRIMARY KEY(ts_code, trade_date))"
    },
    {
      "type": "table",
      "name": "stock_name_history",
      "tbl_name": "stock_name_history",
      "sql": "CREATE TABLE stock_name_history (\n    ts_code     TEXT NOT NULL,\n    name        TEXT NOT NULL,\n    start_date  TEXT NOT NULL,\n    end_date    TEXT,\n    ann_date    TEXT,\n    name_change TEXT,\n    PRIMARY KEY (ts_code, start_date, name)\n)"
    },
    {
      "type": "index",
      "name": "idx_cbind_ts",
      "tbl_name": "cb_indicator",
      "sql": "CREATE INDEX idx_cbind_ts ON cb_indicator(ts_code, trade_date)"
